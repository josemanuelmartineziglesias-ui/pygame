import pygame
import random
import sys
import math

# Inicializar pygame
pygame.init()

# Configuración para móviles
info = pygame.display.Info()
SCREEN_WIDTH, SCREEN_HEIGHT = 480, 800  # Tamaño común para móviles
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Esquivador Cósmico")

# Colores
NEGRO = (0, 0, 0)
BLANCO = (255, 255, 255)
AZUL = (30, 144, 255)
ROJO = (255, 50, 50)
VERDE = (50, 205, 50)
NARANJA = (255, 165, 0)
PURPURA = (128, 0, 128)

# Reloj para controlar FPS
clock = pygame.time.Clock()
FPS = 60

# Clase para el jugador
class Jugador(pygame.sprite.Sprite):
    def _init_(self):
        super()._init_()
        self.image = pygame.Surface((50, 50), pygame.SRCALPHA)
        pygame.draw.polygon(self.image, AZUL, [(25, 0), (0, 50), (50, 50)])
        self.rect = self.image.get_rect(center=(SCREEN_WIDTH//2, SCREEN_HEIGHT-80))
        self.velocidad = 5
        self.vidas = 3
        self.invulnerable = False
        self.invulnerable_tiempo = 0
        
    def update(self):
        # Movimiento controlado por toques
        if pygame.mouse.get_pressed()[0]:
            x, y = pygame.mouse.get_pos()
            # Seguir el dedo del jugador en el eje X
            if x > self.rect.width//2 and x < SCREEN_WIDTH - self.rect.width//2:
                self.rect.centerx = x
        
        # Control de invulnerabilidad
        if self.invulnerable:
            self.invulnerable_tiempo -= 1
            if self.invulnerable_tiempo <= 0:
                self.invulnerable = False
                
        # Parpadeo cuando es invulnerable
        if self.invulnerable and pygame.time.get_ticks() % 200 < 100:
            self.image.set_alpha(100)
        else:
            self.image.set_alpha(255)
            
    def golpear(self):
        if not self.invulnerable:
            self.vidas -= 1
            self.invulnerable = True
            self.invulnerable_tiempo = 90  # 1.5 segundos a 60 FPS
            return True
        return False

# Clase para los meteoritos
class Meteorito(pygame.sprite.Sprite):
    def _init_(self):
        super()._init_()
        self.tamanio = random.randint(20, 60)
        self.image = pygame.Surface((self.tamanio, self.tamanio), pygame.SRCALPHA)
        
        # Color aleatorio para el meteorito
        color = random.choice([ROJO, NARANJA, PURPURA])
        pygame.draw.circle(self.image, color, (self.tamanio//2, self.tamanio//2), self.tamanio//2)
        
        # Hacer el meteorito irregular
        for _ in range(5):
            x = random.randint(0, self.tamanio)
            y = random.randint(0, self.tamanio)
            pygame.draw.circle(self.image, NEGRO, (x, y), random.randint(2, 5))
            
        self.rect = self.image.get_rect()
        self.rect.x = random.randint(0, SCREEN_WIDTH - self.tamanio)
        self.rect.y = random.randint(-100, -40)
        self.velocidad_y = random.randint(3, 8)
        self.rotacion = 0
        self.velocidad_rotacion = random.choice([-3, -2, -1, 1, 2, 3])
        
    def update(self):
        self.rect.y += self.velocidad_y
        self.rotacion = (self.rotacion + self.velocidad_rotacion) % 360
        
        # Rotar la imagen
        imagen_rotada = pygame.transform.rotate(self.image, self.rotacion)
        self.rect = imagen_rotada.get_rect(center=self.rect.center)
        
        # Si el meteorito sale de la pantalla, eliminarlo
        if self.rect.top > SCREEN_HEIGHT:
            self.kill()

# Clase para las estrellas de fondo
class Estrella:
    def _init_(self):
        self.x = random.randint(0, SCREEN_WIDTH)
        self.y = random.randint(0, SCREEN_HEIGHT)
        self.tamanio = random.randint(1, 3)
        self.velocidad = random.randint(1, 3)
        self.color = (random.randint(200, 255), random.randint(200, 255), random.randint(200, 255))
        
    def update(self):
        self.y += self.velocidad
        if self.y > SCREEN_HEIGHT:
            self.y = 0
            self.x = random.randint(0, SCREEN_WIDTH)
            
    def dibujar(self, superficie):
        pygame.draw.circle(superficie, self.color, (self.x, self.y), self.tamanio)

# Clase para partículas de explosión
class Particula:
    def _init_(self, x, y, color):
        self.x = x
        self.y = y
        self.color = color
        self.tamanio = random.randint(2, 6)
        self.velocidad_x = random.uniform(-3, 3)
        self.velocidad_y = random.uniform(-3, 3)
        self.vida = random.randint(20, 40)
        
    def update(self):
        self.x += self.velocidad_x
        self.y += self.velocidad_y
        self.vida -= 1
        self.tamanio = max(0, self.tamanio - 0.1)
        
    def dibujar(self, superficie):
        pygame.draw.circle(superficie, self.color, (int(self.x), int(self.y)), int(self.tamanio))

# Función para mostrar texto en la pantalla
def mostrar_texto(superficie, texto, tamanio, x, y, color=BLANCO):
    fuente = pygame.font.SysFont(None, tamanio)
    texto_surface = fuente.render(texto, True, color)
    texto_rect = texto_surface.get_rect(center=(x, y))
    superficie.blit(texto_surface, texto_rect)

# Función principal del juego
def main():
    # Grupos de sprites
    todos_los_sprites = pygame.sprite.Group()
    meteoritos = pygame.sprite.Group()
    
    # Crear jugador
    jugador = Jugador()
    todos_los_sprites.add(jugador)
    
    # Crear estrellas de fondo
    estrellas = [Estrella() for _ in range(100)]
    
    # Partículas
    particulas = []
    
    # Variables del juego
    puntuacion = 0
    nivel = 1
    meteoritos_por_nivel = 5
    tiempo_ultimo_meteorito = pygame.time.get_ticks()
    intervalo_meteoritos = 1000  # 1 segundo
    
    # Bucle principal del juego
    ejecutando = True
    game_over = False
    
    while ejecutando:
        # Mantener el ritmo del juego
        clock.tick(FPS)
        
        # Eventos de entrada
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                ejecutando = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    ejecutando = False
                if game_over and event.key == pygame.K_r:
                    # Reiniciar juego
                    return main()
            # Para dispositivos táctiles
            elif event.type == pygame.FINGERDOWN:
                if game_over:
                    # Reiniciar juego al tocar la pantalla
                    return main()
        
        if not game_over:
            # Actualizar
            # Actualizar estrellas
            for estrella in estrellas:
                estrella.update()
            
            # Actualizar partículas
            for particula in particulas[:]:
                particula.update()
                if particula.vida <= 0:
                    particulas.remove(particula)
            
            # Actualizar jugador
            jugador.update()
            
            # Generar meteoritos
            tiempo_actual = pygame.time.get_ticks()
            if tiempo_actual - tiempo_ultimo_meteorito > intervalo_meteoritos and len(meteoritos) < nivel * meteoritos_por_nivel:
                nuevo_meteorito = Meteorito()
                meteoritos.add(nuevo_meteorito)
                todos_los_sprites.add(nuevo_meteorito)
                tiempo_ultimo_meteorito = tiempo_actual
            
            # Actualizar meteoritos
            meteoritos.update()
            
            # Detectar colisiones
            colisiones = pygame.sprite.spritecollide(jugador, meteoritos, True)
            for meteorito in colisiones:
                if jugador.golpear():
                    # Crear partículas de explosión
                    for _ in range(20):
                        particulas.append(Particula(meteorito.rect.centerx, meteorito.rect.centery, ROJO))
                
                if jugador.vidas <= 0:
                    game_over = True
            
            # Incrementar puntuación
            puntuacion += 0.1
            nivel = max(1, puntuacion // 100 + 1)
            
            # Aumentar dificultad
            intervalo_meteoritos = max(200, 1000 - nivel * 100)  # Mínimo 200ms entre meteoritos
        
        # Dibujar
        screen.fill(NEGRO)
        
        # Dibujar estrellas
        for estrella in estrellas:
            estrella.dibujar(screen)
        
        # Dibujar partículas
        for particula in particulas:
            particula.dibujar(screen)
        
        # Dibujar sprites
        todos_los_sprites.draw(screen)
        
        # Dibujar HUD
        mostrar_texto(screen, f"Puntuación: {int(puntuacion)}", 30, SCREEN_WIDTH//2, 20)
        mostrar_texto(screen, f"Nivel: {int(nivel)}", 30, 50, 20)
        
        # Dibujar vidas
        for i in range(jugador.vidas):
            pygame.draw.circle(screen, VERDE, (SCREEN_WIDTH - 20 - i*30, 20), 10)
        
        # Pantalla de Game Over
        if game_over:
            pygame.draw.rect(screen, (0, 0, 0, 180), (0, 0, SCREEN_WIDTH, SCREEN_HEIGHT))
            mostrar_texto(screen, "GAME OVER", 64, SCREEN_WIDTH//2, SCREEN_HEIGHT//2 - 50, ROJO)
            mostrar_texto(screen, f"Puntuación: {int(puntuacion)}", 48, SCREEN_WIDTH//2, SCREEN_HEIGHT//2 + 20)
            mostrar_texto(screen, "Toca la pantalla para reiniciar", 36, SCREEN_WIDTH//2, SCREEN_HEIGHT//2 + 100, VERDE)
        
        # Actualizar pantalla
        pygame.display.flip()
    
    pygame.quit()
    sys.exit()

if _name_ == "_main_":
    main()
